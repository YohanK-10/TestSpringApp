# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_NAME=atlaswatch
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/atlaswatch
SPRING_DATABASE_USERNAME=postgres
SPRING_DATABASE_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Mail (SMTP)
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
EMAIL=your-email@example.com
EMAIL_PASSWORD=your-email-password

# ---------------------------------------------------------------------------
# Auth / session
# ---------------------------------------------------------------------------
EXPIRATION_TIME_FOR_REFRESH_TOKEN=86400000
ATLASWATCH_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000

# Local and Docker Compose runs read ignored PEM files from the repository root.
# Generate a PKCS#8 private key and X.509 public key with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
PUBLIC_KEY_PATH=jwt-public.pem
PRIVATE_KEY_PATH=jwt-private.pem

# Hosted environments may instead inject base64-encoded DER values:
# PUBLIC_KEY=your-base64-encoded-x509-der-public-key
# PRIVATE_KEY=your-base64-encoded-pkcs8-der-private-key

# ---------------------------------------------------------------------------
# Google OAuth2
# ---------------------------------------------------------------------------
CLIENT_ID=your-google-client-id
CLIENT_SECRET=your-google-client-secret

# ---------------------------------------------------------------------------
# Redis
# When running via Docker Compose the backend container uses the service name
# "redis" (hardcoded in docker-compose.yml).  This value is only used when
# running the backend directly with `mvn spring-boot:run`.
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# TMDB
# ---------------------------------------------------------------------------
TMDB_API_TOKEN=your-tmdb-token

# One-off semantic metadata maintenance. Keep disabled during ordinary runs.
ATLASWATCH_METADATA_BACKFILL_RUN_ON_STARTUP=false
ATLASWATCH_METADATA_BACKFILL_BATCH_SIZE=100
# 0 means no additional per-run cap.
ATLASWATCH_METADATA_BACKFILL_MAX_ITEMS=0
ATLASWATCH_METADATA_BACKFILL_RATE_LIMIT_MS=100
